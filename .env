# SPENDSTATE // CLOUD CONFIG (committed — this is a PUBLIC web config)
#
# These values ship with the app so users configure nothing: they load the URL,
# click "enable sync", and sign in. A Firebase web apiKey is not a secret — it
# identifies the project, not the user, and cannot read data on its own. Access
# is enforced by firestore.rules (owner-only, per account).
#
# To point a local clone at a DIFFERENT project, override in `.env.local`
# (gitignored) rather than editing this file.

VITE_FIREBASE_API_KEY=AIzaSyCiyNY1i6BYzXmXmVKy1kMpx7CkCazBhS0
VITE_FIREBASE_AUTH_DOMAIN=spend-state.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spend-state
VITE_FIREBASE_STORAGE_BUCKET=spend-state.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=376507973311
VITE_FIREBASE_APP_ID=1:376507973311:web:0b6f6cb2dbb1b7d60f100a
