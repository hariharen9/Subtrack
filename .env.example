# SPENDSTATE // OPTIONAL OVERRIDE
#
# You normally do NOT need this file. The app ships already connected to its
# Firebase project (see `.env`), so end users configure nothing.
#
# Copy this to `.env.local` (gitignored) only if you want a local clone to talk
# to a DIFFERENT Firebase project — e.g. your own staging project.
#
# NOTE: a Firebase web apiKey is NOT a secret. It ships in every Firebase web app
# and is protected by the owner-only rules in `firestore.rules`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
