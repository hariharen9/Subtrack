rules_version = '2';

// SPENDSTATE // FIRESTORE SECURITY RULES
//
// Owner-only. A signed-in user may read and write only their own subtree at
// `users/{uid}/{table}/{id}` — and nothing else anywhere in the database.
// Every other path is explicitly denied, including for signed-in users.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny-by-default for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
