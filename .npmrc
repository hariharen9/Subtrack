# SPENDSTATE // pnpm settings
#
# This project keeps its own dependency store (it did before the cloud change
# too), so plain `pnpm` commands resolve to the same store as `.gitignore`d
# `.pnpm-store/`.
store-dir=.pnpm-store

# Don't run an implicit install before every script — the local store above means
# a plain `pnpm install` is a no-op anyway, and the check aborts in non-TTY runs.
verify-deps-before-run=false
